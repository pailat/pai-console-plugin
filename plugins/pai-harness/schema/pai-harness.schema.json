{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/pai-harness.schema.json",
  "title": ".pai-harness.toml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pai_org",
        "pai_project",
        "linear_team"
      ],
      "properties": {
        "pai_org": {
          "type": "string",
          "minLength": 1
        },
        "pai_project": {
          "type": "string",
          "minLength": 1
        },
        "linear_team": {
          "type": "string",
          "minLength": 1
        },
        "issue_prefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*$"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "description": "Branch the Stop zone diff falls back to when the run recorded no start commit (PAI_HARNESS_BASE), before origin/HEAD, main and master."
        }
      }
    },
    "gates": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        ]
      },
      "properties": {
        "hotfix": {
          "type": "object",
          "additionalProperties": false,
          "description": "Red-release hotfix profile. Active only when active_when FAILS on the release tip and the PR title or a label matches applies_to.",
          "required": [
            "active_when",
            "applies_to",
            "pre_merge",
            "post_merge"
          ],
          "properties": {
            "active_when": {
              "type": "string",
              "minLength": 1,
              "description": "Command run on the release tip; the profile is active only when it fails."
            },
            "applies_to": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Regular expression searched in the PR title and in each label."
            },
            "pre_merge": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Commands that must pass before the merge."
            },
            "post_merge": {
              "type": "string",
              "minLength": 1,
              "description": "Command run on the release tip after the merge: the full gate."
            },
            "revert_on_failure": {
              "type": "boolean",
              "default": true,
              "description": "Emit a revert instruction when post_merge fails."
            }
          }
        }
      }
    },
    "zones": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "globs"
        ],
        "properties": {
          "globs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "root": {
            "type": "boolean"
          }
        }
      }
    },
    "machines": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "os": {
            "type": "string",
            "minLength": 1
          },
          "max_agents": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "queues": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "machine": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "enum": [
              "opus",
              "sonnet",
              "haiku"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_agents": {
          "type": "integer",
          "minimum": 1
        },
        "max_agents_per_machine": {
          "type": "integer",
          "minimum": 1
        },
        "max_open_prs": {
          "type": "integer",
          "minimum": 1
        },
        "turn_timeout_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0.01
        },
        "compaction_alert_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "role_limits": {
      "type": "object",
      "default": {
        "relay": {"max_turns": 400, "max_budget_usd": 15},
        "orchestrator": {"max_turns": 400, "max_budget_usd": 15},
        "lead": {"max_turns": 300, "max_budget_usd": 10},
        "root-reviewer": {"max_turns": 120, "max_budget_usd": 8}
      },
      "propertyNames": {
        "enum": ["relay", "orchestrator", "lead", "implementer", "root-reviewer", "integrator", "distiller", "gate-triager", "mechanical", "watcher"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_turns": {"type": "integer", "minimum": 1},
          "max_budget_usd": {"type": "number", "minimum": 0.01}
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bypass_permissions": {
          "type": "boolean",
          "default": true,
          "description": "Pass --permission-mode bypassPermissions to every claude run (owner policy). Set false to opt this project out: claude -p has no prompts, so a tool that is not pre-approved is denied and the run ends blocked. --allowed-tools limits nothing while bypass is on. Deny rules and hooks apply either way."
        },
        "require_deny_baseline": {
          "type": "boolean",
          "default": true,
          "description": "With bypass on, refuse to start a run (blocked, a named BLOCKER) unless the effective Claude Code settings carry the deny baseline (examples/settings.deny.json). Set false only where another control already denies those actions."
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents_file": {
          "type": "string",
          "minLength": 1
        },
        "root_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "must": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "push_wrapper": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relay": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "orchestrator": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "lead": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "implementer": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "root-reviewer": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "integrator": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "distiller": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "gate-triager": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "mechanical": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "watcher": {
          "enum": [
            "opus",
            "sonnet",
            "haiku",
            "none"
          ]
        }
      },
      "default": {
        "relay": "sonnet",
        "orchestrator": "sonnet",
        "lead": "sonnet",
        "implementer": "sonnet",
        "root-reviewer": "opus",
        "integrator": "sonnet",
        "distiller": "sonnet",
        "gate-triager": "sonnet",
        "mechanical": "haiku",
        "watcher": "none"
      }
    },
    "role_zones": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "relay",
          "orchestrator",
          "lead",
          "implementer",
          "root-reviewer",
          "integrator",
          "distiller",
          "gate-triager",
          "mechanical",
          "watcher"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the distiller writes Pai Knowledge. Absent means no target, and the distiller fails closed.",
      "required": [
        "organization"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1,
          "description": "Pai organization slug or id."
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Pai project slug or id. Give this or product, not both."
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "description": "Pai product slug or id. Give this or project, not both."
        },
        "streams": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "description": "Override for one stream or queue: its own project or product; the organization defaults to the top-level one.",
            "properties": {
              "organization": {
                "type": "string",
                "minLength": 1,
                "description": "Pai organization slug or id."
              },
              "project": {
                "type": "string",
                "minLength": 1,
                "description": "Pai project slug or id. Give this or product, not both."
              },
              "product": {
                "type": "string",
                "minLength": 1,
                "description": "Pai product slug or id. Give this or project, not both."
              }
            },
            "oneOf": [
              {
                "required": [
                  "project"
                ],
                "not": {
                  "required": [
                    "product"
                  ]
                }
              },
              {
                "required": [
                  "product"
                ],
                "not": {
                  "required": [
                    "project"
                  ]
                }
              }
            ]
          },
          "description": "Per-stream overrides, chosen by the launcher's --stream option or the queue name."
        }
      },
      "oneOf": [
        {
          "required": [
            "project"
          ],
          "not": {
            "required": [
              "product"
            ]
          }
        },
        {
          "required": [
            "product"
          ],
          "not": {
            "required": [
              "project"
            ]
          }
        }
      ]
    },
    "pai": {
      "type": "object",
      "additionalProperties": false,
      "description": "How headless runs reach the Pai MCP with a machine token. The token itself is never configured here: token_file only names the file, which must be mode 0600 and owned by the current user.",
      "properties": {
        "token_file": {
          "type": "string",
          "minLength": 1,
          "default": "~/.config/pai-harness/token",
          "description": "Path of the machine token file; PAI_HARNESS_TOKEN_FILE overrides it."
        },
        "mcp_url": {
          "type": "string",
          "default": "",
          "pattern": "^$|^https://|^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])",
          "description": "Pai MCP endpoint. When set, the launcher passes a machine-only MCP config and fails closed unless the server connects."
        },
        "token_scope": {
          "type": "string",
          "enum": ["read", "write"],
          "default": "write",
          "description": "What the machine token may do in Pai Knowledge. With read, the distiller searches and reads only, saves the proposed nodes as a report and stops with the BLOCKER `knowledge write needs a project-scope write token`. PAI_HARNESS_TOKEN_SCOPE overrides it; the launcher exports it."
        }
      }
    }
  }
}
