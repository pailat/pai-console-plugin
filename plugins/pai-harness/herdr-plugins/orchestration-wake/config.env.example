# pai.orchestration-wake settings. Copy to $(herdr plugin config-dir pai.orchestration-wake)/config.env. Environment wins over this file.
# Who is woken for a pane that has pai tokens but no cache file (a pane launched without pai-pane-meta). Agent name or pane id,
# optionally prefixed with a host alias from PAI_WAKE_HOSTS (host-a:orchestrator). Empty = no fallback.
PAI_WAKE_FALLBACK=orchestrator
# Optional: also append every wake message to this file (a plain outbox for agents that cannot be prompted).
PAI_WAKE_OUTBOX=
# Host aliases for remote targets "<alias>:<agent>": space separated alias=ssh-host[:remote-shell]. Remote shell defaults to bash;
# use zsh for macOS. The remote machine needs herdr in a login-shell PATH. Names without an alias are agents on THIS machine.
PAI_WAKE_HOSTS="host-a=ssh-host-a host-b=ssh-host-b host-c=ssh-host-c:zsh"
# ssh options for remote targets (word list). Default: -o BatchMode=yes -o ConnectTimeout=8. IdentityAgent=none skips an ssh agent
# that stalls a non-interactive call; drop it when the agent is what holds your key.
PAI_WAKE_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=8 -o IdentityAgent=none"
# PATH prefix for the remote herdr call (colon separated; only A-Za-z0-9_./:~- are accepted, anything else is ignored and logged).
# Write a tilde (~/bin), never $HOME: "$" is rejected, so a $HOME value would be ignored. Use it when a non-interactive remote
# shell does not find herdr. Empty = no prefix.
PAI_WAKE_REMOTE_PATH=~/bin
# Minimum seconds between two "finished" wakes from the same pane to the same target. Blocked and exited wakes are never held back. 0 disables it.
PAI_WAKE_MIN_INTERVAL=60
# Backstop: at most this many wakes of any kind from one pane to one target per hour. 0 disables it.
PAI_WAKE_MAX_PER_HOUR=20
