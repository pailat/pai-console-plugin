# pai.turn-recorder settings. Copy to $(herdr plugin config-dir pai.turn-recorder)/config.env. Environment wins over this file.
# Where an agent writes its stream-json frames, as a path template. {name} is the pane's name token, {pane} the sanitized pane id.
# A pane that carries a "stream" metadata token uses that path instead. Empty and no token = record pane events only.
PAI_RECORDER_STREAM=/var/tmp/acme/streams/{name}.jsonl
# Most bytes of stream read per event (default 8388608). The rest is read on the next event.
PAI_RECORDER_MAX_BYTES=8388608
