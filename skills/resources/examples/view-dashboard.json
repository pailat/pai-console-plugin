{
  "tool": "page_create",
  "input": {
    "organizationId": "ORG_ID",
    "projectId": "PROJECT_ID",
    "path": "dashboards/project-status",
    "title": "Estado del proyecto",
    "description": "Tablero con avance, hitos y horas del proyecto al corte.",
    "audience": "equipo",
    "summary": "Tablero inicial de estado del proyecto",
    "idempotencyKey": "page-shop-dashboards-project-status",
    "content": {
      "schemaVersion": 1,
      "componentSetVersion": "pai-core-v1",
      "layout": "canvas",
      "sections": [
        {
          "id": "dashboard",
          "title": "Tablero",
          "blocks": [
            {
              "id": "statusView",
              "type": "view",
              "title": "Estado del proyecto",
              "spec": {
                "root": "root",
                "elements": {
                  "root": { "type": "Stack", "props": { "direction": "vertical", "gap": "lg" }, "children": ["header", "kpis", "tabs"] },
                  "header": { "type": "Section", "props": { "title": "Tienda en línea", "description": "Corte al 2026-10-06" }, "children": ["alert"] },
                  "alert": { "type": "Alert", "props": { "title": "Hito 3 en riesgo", "message": "La integración de pagos depende de las credenciales del cliente.", "type": "warning" } },
                  "kpis": { "type": "Grid", "props": { "columns": 3, "gap": "md" }, "children": ["kProgress", "kMilestones", "kHours"] },
                  "kProgress": { "type": "Metric", "props": { "label": "Avance", "value": "68 %", "detail": "Corte 2026-10-06", "trend": "up" } },
                  "kMilestones": { "type": "Metric", "props": { "label": "Hitos cerrados", "value": "2 de 4" } },
                  "kHours": { "type": "Metric", "props": { "label": "Horas del mes", "value": "98 h", "trend": "flat" } },
                  "tabs": { "type": "Tabs", "props": { "tabs": [ { "label": "Hitos", "value": "milestones" }, { "label": "Horas", "value": "hours" } ], "defaultValue": "milestones" }, "children": ["milestonesTable", "hoursChart"] },
                  "milestonesTable": {
                    "type": "Table",
                    "props": {
                      "columns": ["Hito", "Fin", "Estado"],
                      "rows": [
                        ["Descubrimiento", "2026-08-30", "Completado"],
                        ["Catálogo y carrito", "2026-09-27", "Completado"],
                        ["Pagos", "2026-10-25", "En curso"],
                        ["Lanzamiento", "2026-11-15", "Pendiente"]
                      ],
                      "caption": "Fechas de la línea base"
                    }
                  },
                  "hoursChart": {
                    "type": "Chart",
                    "props": { "title": "Horas por mes", "kind": "bar", "categories": ["Ago", "Sep", "Oct"], "series": [ { "name": "Horas", "values": [120, 140, 98] } ], "unit": "h" }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
