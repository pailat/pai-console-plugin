{
  "tool": "page_create",
  "input": {
    "organizationId": "ORG_ID",
    "projectId": "PROJECT_ID",
    "path": "dashboards/project-status",
    "title": "Project status",
    "description": "Dashboard of project progress, milestones, collections, and hours as of the reporting date.",
    "audience": "internal",
    "summary": "Project status dashboard as of 2026-10-06",
    "idempotencyKey": "page-shop-dashboards-project-status",
    "content": {
      "schemaVersion": 1,
      "componentSetVersion": "pai-core-v1",
      "layout": "canvas",
      "sections": [
        {
          "id": "dashboard",
          "title": "Dashboard",
          "blocks": [
            {
              "id": "statusView",
              "type": "view",
              "title": "Project status",
              "spec": {
                "root": "root",
                "elements": {
                  "root": { "type": "Stack", "props": { "direction": "vertical", "gap": "lg" }, "children": ["header", "kpis", "detailTabs"] },
                  "header": { "type": "Section", "props": { "title": "Online shop", "description": "As of 2026-10-06, using timeline_get and payment_list data." }, "children": ["health", "riskAlert"] },
                  "health": { "type": "StatusBadge", "props": { "label": "At risk", "tone": "warning" } },
                  "riskAlert": { "type": "Alert", "props": { "title": "Milestone 3 at risk", "message": "Payment integration depends on client credentials; without them by 2026-10-15, the milestone moves one week.", "type": "warning" } },
                  "kpis": { "type": "Grid", "props": { "columns": 4, "gap": "md" }, "children": ["kpiProgress", "kpiMilestones", "kpiCollected", "kpiHours"] },
                  "kpiProgress": { "type": "Metric", "props": { "label": "Progress", "value": "68 %", "detail": "vs. 55 % as of 2026-09-29", "trend": "up", "tone": "positive" } },
                  "kpiMilestones": { "type": "Metric", "props": { "label": "Closed milestones", "value": "2 of 4" } },
                  "kpiCollected": { "type": "Metric", "props": { "label": "Collected", "value": "$240,000", "unit": "MXN", "detail": "of $480,000 contract" } },
                  "kpiHours": { "type": "Metric", "props": { "label": "October hours", "value": "98", "unit": "h", "detail": "As of 2026-10-06" } },
                  "detailTabs": { "type": "UnderlinedTabs", "props": { "tabs": [ { "label": "Milestones", "value": "milestones" }, { "label": "Hours", "value": "hours" } ], "defaultValue": "milestones" }, "children": ["milestonesStack", "hoursStack"] },
                  "milestonesStack": { "type": "Stack", "props": { "direction": "vertical", "gap": "md" }, "children": ["stages", "milestonesTable"] },
                  "stages": {
                    "type": "Stages",
                    "props": {
                      "items": [
                        { "label": "Discovery", "status": "done", "detail": "2026-08-30" },
                        { "label": "Catalog and cart", "status": "done", "detail": "2026-09-27" },
                        { "label": "Payments", "status": "current", "detail": "2026-10-25" },
                        { "label": "Launch", "status": "upcoming", "detail": "2026-11-15" }
                      ]
                    }
                  },
                  "milestonesTable": {
                    "type": "Table",
                    "props": {
                      "columns": ["Milestone", "End", "Status", "Collection"],
                      "rows": [
                        ["Discovery", "2026-08-30", "Completed", "Paid"],
                        ["Catalog and cart", "2026-09-27", "Completed", "Paid"],
                        ["Payments", "2026-10-25", "In progress", "Pending"],
                        ["Launch", "2026-11-15", "Pending", "Pending"]
                      ],
                      "caption": "Baseline dates"
                    }
                  },
                  "hoursStack": { "type": "Stack", "props": { "direction": "vertical", "gap": "md" }, "children": ["hoursChart", "hoursByArea"] },
                  "hoursChart": {
                    "type": "Chart",
                    "props": { "title": "Hours by month", "kind": "bar", "categories": ["Aug", "Sep", "Oct"], "series": [ { "name": "Hours", "values": [120, 140, 98] } ], "unit": "h", "description": "October through day 6." }
                  },
                  "hoursByArea": {
                    "type": "BarList",
                    "props": { "items": [ { "label": "Development", "value": 62 }, { "label": "Design", "value": 21 }, { "label": "Management", "value": 15 } ], "showPercent": true }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
