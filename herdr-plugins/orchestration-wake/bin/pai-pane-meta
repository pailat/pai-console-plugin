#!/usr/bin/env bash
# pai-pane-meta <pane_id> key=value ...  Set the pane's pai metadata tokens (role, parent, requester, issue, name, verdict,
# wake_on_done) AND cache them in <plugin config dir>/panes/: herdr drops tokens when the server restarts and before pane.exited
# fires. Launchers call this instead of `herdr pane report-metadata`. Never fails the launcher. Uses HERDR_BIN_PATH (else herdr).
H=${HERDR_BIN_PATH:-herdr}; pane=${1:?pane_id}; shift
[ $# -gt 0 ] || exit 0
args=(); json='{}'
for kv in "$@"; do k=${kv%%=*}; v=${kv#*=}; args=(${args[@]+"${args[@]}"} --token "$k=$v"); json=$(jq -c --arg k "$k" --arg v "$v" '.tokens[$k]=$v' <<<"$json"); done
"$H" pane report-metadata "$pane" --source pai "${args[@]}" >/dev/null 2>&1 || exit 0
C=${HERDR_PLUGIN_CONFIG_DIR:-$("$H" plugin config-dir pai.orchestration-wake 2>/dev/null)}; [ -n "$C" ] || exit 0
mkdir -p "$C/panes" 2>/dev/null; printf '%s\n' "$json" >"$C/panes/$(printf %s "$pane" | tr -c 'A-Za-z0-9' _).json"
exit 0
